generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum IdentificationType {
  CC
  TI
  CE
  PA
  NIT
  PPT
  PEP
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum RolePersonaStatus {
  ACTIVE
  INACTIVE
}

enum BillingCycle {
  MONTHLY
  YEARLY
  QUARTERLY
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
}

enum ResidentialComplexStatus {
  ACTIVE
  INACTIVE
}

enum PhysicalGroupType {
  TOWER
  BLOCK
}

enum PrivateUnitType {
  APARTMENT
  HOUSE
  LOCAL
  OFFICE
}

enum PrivateUnitStatus {
  ACTIVE
  INACTIVE
}

model Plan {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  maxComplexes Int
  maxUnits     Int
  monthlyPrice Decimal    @db.Decimal(10, 2)
  yearlyPrice  Decimal    @db.Decimal(10, 2)
  quarterlyPrice Decimal  @db.Decimal(10, 2)
  status       PlanStatus @default(ACTIVE)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model ResidentialComplex {
  id      String                   @id @default(uuid())
  name    String
  address String
  city    String
  status  ResidentialComplexStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  physicalGroups PhysicalGroup[]
  privateUnits   PrivateUnit[]
}

model PhysicalGroup {
  id                   String            @id @default(uuid())
  residentialComplexId String
  name                 String
  type                 PhysicalGroupType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  residentialComplex ResidentialComplex @relation(fields: [residentialComplexId], references: [id], onDelete: Cascade)
  privateUnits       PrivateUnit[]

  @@index([residentialComplexId])
}

model PrivateUnit {
  id                   String            @id @default(uuid())
  residentialComplexId String
  physicalGroupId      String?
  identifier           String
  type                 PrivateUnitType
  status               PrivateUnitStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  residentialComplex ResidentialComplex @relation(fields: [residentialComplexId], references: [id], onDelete: Cascade)

  physicalGroup PhysicalGroup? @relation(fields: [physicalGroupId], references: [id], onDelete: SetNull)

  @@index([residentialComplexId])
  @@index([physicalGroupId])
}

model Person {
  id                   String             @id @default(uuid())
  identificationType   IdentificationType
  identificationNumber String
  fullName             String
  email                String?
  phone                String?
  status               PersonStatus       @default(ACTIVE)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identificationType, identificationNumber])
  @@map("people")
}

model RolePersona {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String            @unique
  description String
  status      RolePersonaStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role_personas")
}

model Subscription {
  id String @id @default(uuid())

  personId String
  person   Person @relation(fields: [personId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  billingCycle BillingCycle
  price        Decimal      @db.Decimal(10, 2)

  startDate       DateTime
  endDate         DateTime?
  nextBillingDate DateTime?
  status          SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, status])
  @@map("subscriptions")
}
