generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum PlanStatus {
  ACTIVE
  INACTIVE
}

enum IdentificationType {
  CC
  TI
  CE
  PA
  NIT
  PPT
  PEP
}

enum PersonStatus {
  ACTIVE
  INACTIVE
}

enum RolePersonaStatus {
  ACTIVE
  INACTIVE
}

enum BillingCycle {
  MONTHLY
  YEARLY
  QUARTERLY
}

enum SubscriptionStatus {
  ACTIVE
  GRACE_PERIOD
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

enum ResidentialComplexStatus {
  ACTIVE
  INACTIVE
}

enum PhysicalGroupType {
  TOWER
  BLOCK
}

enum PrivateUnitType {
  APARTMENT
  HOUSE
  LOCAL
  OFFICE
}

enum PrivateUnitStatus {
  ACTIVE
  INACTIVE
}

enum PersonUnitStatus {
  ACTIVE
  FINISHED
}

enum AccessRoleStatus {
  ACTIVE
  INACTIVE
}

enum PermissionStatus {
  ACTIVE
  INACTIVE
}

enum AccessAccountStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

model Plan {
  id             String     @id @default(uuid())
  code           String     @unique
  name           String
  maxComplexes   Int
  maxUnits       Int
  monthlyPrice   Decimal    @db.Decimal(10, 2)
  yearlyPrice    Decimal    @db.Decimal(10, 2)
  quarterlyPrice Decimal    @db.Decimal(10, 2)
  status         PlanStatus @default(ACTIVE)
  isPublic       Boolean    @default(true)
  trialDays      Int        @default(0)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}

model ResidentialComplex {
  id      String                   @id @default(uuid())
  name    String
  address String
  city    String
  status  ResidentialComplexStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  physicalGroups PhysicalGroup[]
  privateUnits   PrivateUnit[]
  memberships    Membership[]
}

model PhysicalGroup {
  id                   String            @id @default(uuid())
  residentialComplexId String
  name                 String
  type                 PhysicalGroupType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  residentialComplex ResidentialComplex @relation(fields: [residentialComplexId], references: [id], onDelete: Cascade)
  privateUnits       PrivateUnit[]

  @@index([residentialComplexId])
}

model PrivateUnit {
  id                   String            @id @default(uuid())
  residentialComplexId String
  physicalGroupId      String?
  identifier           String
  type                 PrivateUnitType
  status               PrivateUnitStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  residentialComplex ResidentialComplex @relation(fields: [residentialComplexId], references: [id], onDelete: Cascade)

  physicalGroup PhysicalGroup? @relation(fields: [physicalGroupId], references: [id], onDelete: SetNull)

  personUnits PersonUnit[]

  @@index([residentialComplexId])
  @@index([physicalGroupId])
}

model Person {
  id                   String             @id @default(uuid())
  identificationType   IdentificationType
  identificationNumber String
  fullName             String
  email                String?
  phone                String?
  status               PersonStatus       @default(ACTIVE)

  subscriptions Subscription[]
  personUnits   PersonUnit[]
  accessAccount AccessAccount?
  memberships   Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identificationType, identificationNumber])
  @@map("people")
}

model RolePersona {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String            @unique
  description String
  status      RolePersonaStatus @default(ACTIVE)

  personUnits PersonUnit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("role_personas")
}

model Subscription {
  id String @id @default(uuid())

  personId String
  person   Person @relation(fields: [personId], references: [id])

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  billingCycle BillingCycle
  price        Decimal      @db.Decimal(10, 2)

  startDate       DateTime
  endDate         DateTime?
  nextBillingDate DateTime?
  status          SubscriptionStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId, status])
  @@map("subscriptions")
}

model PersonUnit {
  id String @id @default(uuid())

  personId String
  person   Person @relation(fields: [personId], references: [id])

  privateUnitId String
  privateUnit   PrivateUnit @relation(fields: [privateUnitId], references: [id])

  rolePersonaId String
  rolePersona   RolePersona @relation(fields: [rolePersonaId], references: [id])

  startDate DateTime
  endDate   DateTime?

  status PersonUnitStatus @default(ACTIVE)

  observations String?

  @@index([personId])
  @@index([privateUnitId])
  @@index([rolePersonaId])
  @@map("person_units")
}

model AccessRole {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String           @unique
  description String
  status      AccessRoleStatus @default(ACTIVE)

  accessRolePermissions AccessRolePermission[]
  memberships           Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("access_roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String           @unique
  description String
  status      PermissionStatus @default(ACTIVE)

  accessRolePermissions AccessRolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model AccessRolePermission {
  id           String @id @default(uuid())
  accessRoleId String
  permissionId String

  accessRole AccessRole @relation(fields: [accessRoleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt DateTime @default(now())

  @@unique([accessRoleId, permissionId])
  @@map("access_role_permissions")
}

model AccessAccount {
  id             String              @id @default(uuid())
  personId       String              @unique
  externalAuthId String              @unique
  status         AccessAccountStatus @default(ACTIVE)

  person      Person       @relation(fields: [personId], references: [id])
  memberships Membership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("access_accounts")
}

model Membership {
  id                   String           @id @default(uuid())
  personId             String
  accessAccountId      String?
  residentialComplexId String
  accessRoleId         String
  status               MembershipStatus @default(ACTIVE)
  startDate            DateTime
  endDate              DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  person             Person             @relation(fields: [personId], references: [id])
  accessAccount      AccessAccount?     @relation(fields: [accessAccountId], references: [id])
  residentialComplex ResidentialComplex @relation(fields: [residentialComplexId], references: [id])
  accessRole         AccessRole         @relation(fields: [accessRoleId], references: [id])

  @@index([personId])
  @@index([accessAccountId])
  @@index([residentialComplexId])
  @@index([accessRoleId])
  @@index([status])
}
