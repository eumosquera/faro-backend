generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum ResidentialComplexStatus {
  ACTIVE
  INACTIVE
}

model ResidentialComplex {
  id      String                   @id @default(uuid())
  name    String
  address String
  city    String
  status  ResidentialComplexStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
